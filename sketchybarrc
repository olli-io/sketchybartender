# Sketchybar configuration with Rust helper daemon
# The daemon handles all plugin logic for better performance

nohup /opt/homebrew/bin/miniserve "${HOME}/.config/html/vimium-landing.html" --port 8082 >/dev/null 2>&1 &

##### Bar Appearance #####
# Icons are Lucide glyphs (https://lucide.dev), drawn with the Lucide icon font
# that install.sh puts in ~/Library/Fonts. Workspace items show their ID as the
# icon, so they keep the text font. sketchybartender sets the glyphs.
lucide_font="lucide:Regular"

sketchybar --bar position=top height=33 blur_radius=0 color=0xff141617 margin=0 padding_left=15 padding_right=10
##### Changing Defaults #####
default=(
  icon.font="JetbrainsMono Nerd Font:Bold:15.0"
  label.font="JetbrainsMono Nerd Font:Bold:13.0"
  icon.color=0xffddc7a1
  label.color=0xffddc7a1
  icon.padding_left=6
  icon.padding_right=6
  label.padding_right=6
  padding_right=4
  y_offset=1
)
sketchybar --default "${default[@]}"

##### Adding Workspace Indicator #####
# Workspace updates come directly from the window manager (AeroSpace or Rift,
# from "window_manager" in sketchybartender.json) → sketchybartender.
# No need for sketchybar event subscriptions. A click focuses the workspace
# through the same window manager.

# Add workspace items for lettered workspaces (no subscriptions, updated by workspace_manager)
# The icon is the workspace ID. The label is one dot for each window (an
# outlined dot for an empty workspace), so the dots come after the ID.
workspace_items=()
for workspace in {1..9} {a..z} ; do
    sketchybar --add item "workspace.$workspace" left \
        --set "workspace.$workspace" \
        icon.font="JetbrainsMono Nerd Font:Bold:13.0" \
        label.font="JetbrainsMono Nerd Font:Bold:11.0" \
        background.corner_radius=0 \
        background.height=22 \
        background.drawing=off \
        icon.padding_left=0 \
        icon.padding_right=6 \
        label.padding_left=0 \
        label.padding_right=2 \
        label.y_offset=0 \
        padding_left=0 \
        padding_right=14 \
        drawing=off \
        click_script="$HOME/.local/bin/sketchycli focus-workspace $workspace"
    workspace_items+=("workspace.$workspace")
done

