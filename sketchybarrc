##### Weather (FMI open data) #####
# Two items, painted by sketchybartender, which also decides which displays
# each one is shown on (display_change re-runs that):
#   weather       right of the notch ("e"), built-in display only
#   weather.wide  centered, displays without a notch
# Both stay hidden until the first reading arrives.
weather_props=(
  click_script="open -na kitty --args $HOME/.local/bin/forecastui"
  icon.font="$lucide_font:15.0"
  label.font="JetbrainsMono Nerd Font:Bold:13.0"
  icon.padding_left=0
  icon.padding_right=4
  padding_left=8
  padding_right=0
  drawing=off
)
sketchybar --add item weather e \
           --subscribe weather display_change \
           --set weather "${weather_props[@]}" \
           padding_left=0 \
           script="$HOME/.local/bin/sketchycli on-display-configuration-changed"
sketchybar --add item weather.wide center \
           --set weather.wide "${weather_props[@]}"

sketchybar --update

# sketchybartender is started at login by its own LaunchAgent
# (~/Library/LaunchAgents/local.sketchybartender.plist), which waits for the
# items above to exist. It is no longer restarted from here, so after a
# `sketchybar --reload` items stay empty until the daemon's next refresh; run
# `launchctl kickstart -k gui/$(id -u)/local.sketchybartender` to repaint now.
